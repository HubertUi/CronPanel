# CronPanel container environment - EXAMPLE for a new deployment.
# Copy to `.env.docker` and fill in real values.
# `.env.docker` is gitignored; never commit the real file.

# --- Application ---
APP_NAME=CronPanel
DEBUG=false

# --- Security ---
# Required (>=32 chars). MUST be stable across restarts (JWT signing).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- Database (inside the container, points to the named volume) ---
DATABASE_URL=sqlite:////app/backend/data/cronpanel.db

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:8000

# --- Execution engine ---
EXECUTION_TIMEOUT_SECONDS=60
EXECUTION_OUTPUT_MAX_CHARS=65536
# Empty -> backend/scripts_allowlist inside the container (scripts volume).
EXECUTION_SCRIPTS_DIR=

# --- Scheduler (Phase 5) ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=America/Lima
SCHEDULER_MISFIRE_GRACE_SECONDS=90
SCHEDULER_SYNC_INTERVAL_SECONDS=30

# --- Initial administrator (created on first start by init_db) ---
# ADMIN_PASSWORD is REQUIRED in a container (no interactive prompt).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cronpanel.local
# Must satisfy the password policy (>=10 chars, upper+lower+digit).
ADMIN_PASSWORD=