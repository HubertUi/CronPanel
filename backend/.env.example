# CronPanel - example environment configuration.
# Copy to `.env` and adjust values. NEVER commit the real .env file.

# --- Application ---
APP_NAME=CronPanel
DEBUG=true

# --- Security ---
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- Login brute-force protection ---
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# --- Password policy ---
PASSWORD_MIN_LENGTH=10

# --- Database (SQLite for development) ---
DATABASE_URL=sqlite:///cronpanel.db

# --- CORS (comma separated origins) ---
CORS_ORIGINS=http://localhost:8000

# --- Execution engine (Phase 4) ---
# Timeout per script execution, in seconds (1-300).
EXECUTION_TIMEOUT_SECONDS=60
# Per-stream output cap for stdout/stderr (1024 - 1_000_000 chars).
EXECUTION_OUTPUT_MAX_CHARS=1024
# Allow-list root directory for registered scripts. Leave empty to default to
# backend/scripts_allowlist/.
EXECUTION_SCRIPTS_DIR=

# --- Scheduler (Phase 5) ---
# Master switch: keeps a background scheduler inside the app process. Keep it
# enabled with a single uvicorn worker (current container setup).
SCHEDULER_ENABLED=true
# IANA time zone used to interpret cron expressions and schedule the next run.
SCHEDULER_TIMEZONE=America/Lima
# How late (seconds) a missed trigger may still fire before being dropped.
# A bounded grace + coalescing prevents restart floods.
SCHEDULER_MISFIRE_GRACE_SECONDS=90
# Safety-net resync interval against the database (seconds).
SCHEDULER_SYNC_INTERVAL_SECONDS=30

# --- Initial administrator (used ONLY by: python -m app.database.init_db) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cronpanel.local
# Prefer leaving this empty so the init script prompts safely instead of
# storing the password in the file. Set it only for non-interactive installs.
ADMIN_PASSWORD=
